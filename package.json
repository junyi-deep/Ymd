{
  "name": "ymd",
  "version": "0.2.6",
  "private": true,
  "description": "本地 Markdown 与 Excalidraw 编辑器",
  "author": "Ymd",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n vite,electron \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http-get://127.0.0.1:5173 && electron . --dev\"",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.main.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json && node scripts/build-window-backdrop.cjs",
    "build": "npm run check && npm run build:main && vite build",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@svgdotjs/svg.js": "3.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/ripgrep-universal": "^1.18.0",
    "@zip.js/zip.js": "^2.25.0",
    "concurrently": "^10.0.7",
    "dompurify": "^3.4.18",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.73.0",
    "marked": "^18.2.0",
    "marked-footnote": "^1.4.0",
    "pele": "^1.13.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-mind-map": "^0.14.0-fix.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "optionalDependencies": {
    "koffi": "3.3.8"
  }
}
